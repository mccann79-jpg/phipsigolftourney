# Copy this file to `.env` for local development.
#
# Only TWO values are required. Get them from the Firebase console:
# Project settings -> General -> Your apps -> SDK setup and configuration.
# Use the copy button rather than retyping - a single wrong character in the
# API key fails with a confusing "API key not valid" error.
#
# These are not secret keys; they identify your Firebase project the way a
# public URL does. Real access control lives in firestore.rules.
#
# For the GitHub Pages deploy, add these same two as repository secrets
# (Settings -> Secrets and variables -> Actions) using these exact names.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Everything below is OPTIONAL - leave blank unless you have a custom setup.
# authDomain defaults to <projectId>.firebaseapp.com. The rest cover Firebase
# features this app doesn't use (Cloud Storage, push notifications,
# Analytics), so they can stay empty.
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
