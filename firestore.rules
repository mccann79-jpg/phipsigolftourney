rules_version = '2';

// Paste this into the Firebase Console: Firestore Database -> Rules -> Publish.
// See README.md for the full setup walkthrough.
//
// There's no admin account in this app — every visitor is silently signed in
// anonymously (see src/firebase.js), which is enough to tell "some visitor"
// apart from "nobody" without anyone creating an account. Any signed-in
// visitor can create the initial team documents (auto-seeding, see
// ensureTeamsSeeded in src/data/firestoreApi.js). Once a team is claimed
// (`claimedBy` is non-null), only the anonymous session that claimed it
// (`claimedByUid`) can update `scores` or `claimedBy` again — this is what
// stops another visitor from taking over a team that already has a
// scorekeeper. Roster fields (players, teeTime, ghinAvg, strokeAdvantage)
// can only be set at creation time, never changed afterward by a client — if
// you need to edit the roster later, do it directly in the Firebase console,
// which bypasses these rules entirely.
//
// The one deliberate exception: any signed-in visitor can CLEAR a claim
// (set claimedBy/claimedByUid to null, nothing else) — this is what backs
// the admin PIN section in the Info tab (src/adminConfig.js), for freeing up
// a stuck scorekeeper from a phone on the course with no console access.
// The PIN is a UI speed bump only, not something these rules can check, so
// this path is intentionally open to any visitor; it can only release a
// claim, never set one or touch scores, to keep the blast radius small.
//
// One session can't be scorekeeper for two teams at once: claiming a team
// checks the other 6 fixed group docs for an existing claim under the same
// `claimedByUid` and rejects the write if one is found. There are only ever
// 7 teams, so this is spelled out explicitly rather than looped. This uses
// get() only (not exists() + get()) to stay under Firestore's ~10
// document-access-call budget per request — 6 other docs at 2 calls each
// would be 12 and silently deny every claim. get() alone assumes all 7 docs
// already exist, which auto-seeding guarantees before any claim UI renders.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isClaiming() {
      return resource.data.claimedBy == null && request.resource.data.claimedBy != null;
    }

    function heldElsewhere(otherId) {
      // Freshly-seeded, never-claimed docs only have `claimedBy: null` —
      // `claimedByUid` doesn't exist on them until a first claim sets it, so
      // this must use a null-safe accessor. A direct `.claimedByUid` field
      // access throws "Property is undefined" on those docs, which Firestore
      // treats as a rule evaluation error (auto-deny) — silently breaking
      // every claim, not just the one being checked.
      return get(/databases/$(database)/documents/teams/$(otherId)).data.get('claimedByUid', null) == request.auth.uid;
    }

    function alreadyHoldsAClaim(teamId) {
      return (teamId != 'group-1' && heldElsewhere('group-1')) ||
        (teamId != 'group-2' && heldElsewhere('group-2')) ||
        (teamId != 'group-3' && heldElsewhere('group-3')) ||
        (teamId != 'group-4' && heldElsewhere('group-4')) ||
        (teamId != 'group-5' && heldElsewhere('group-5')) ||
        (teamId != 'group-6' && heldElsewhere('group-6')) ||
        (teamId != 'group-7' && heldElsewhere('group-7'));
    }

    function isClaimEdit(teamId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores', 'claimedBy', 'claimedByUid', 'updatedAt']) &&
        (resource.data.claimedBy == null || resource.data.get('claimedByUid', null) == request.auth.uid) &&
        (!isClaiming() || !alreadyHoldsAClaim(teamId));
    }

    function isClearingClaim() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedByUid', 'updatedAt']) &&
        request.resource.data.claimedBy == null &&
        request.resource.data.claimedByUid == null;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isClaimEdit(teamId) || isClearingClaim());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
