rules_version = '2';

// Paste this into the Firebase Console: Firestore Database -> Rules -> Publish.
// See README.md for the full setup walkthrough.
//
// There's no admin account in this app — every visitor is silently signed in
// anonymously (see src/firebase.js), which is enough to tell "some visitor"
// apart from "nobody" without anyone creating an account. Any signed-in
// visitor can create the initial team documents (auto-seeding, see
// ensureTeamsSeeded in src/data/firestoreApi.js) and can update a team's
// `scores` and `claimedBy` fields — that's the self-service scorekeeper
// model. Roster fields (players, teeTime, ghinAvg, strokeAdvantage) can only
// be set at creation time, never changed afterward by a client — if you need
// to edit the roster later, do it directly in the Firebase console, which
// bypasses these rules entirely.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores', 'claimedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
